################################################################### params ##

export arToken

# The url to be used for querying public ip address.

export arIp4QueryUrl="http://ipv4.rehi.org/ip"
export arIp6QueryUrl="http://ipv6.rehi.org/ip"

# The temp file to store the last record ip

export arLastRecordFile=/tmp/ardnspod_last_record

# The error code to return when a ddns record is not changed
# By default, report unchanged event as success

export arErrCodeUnchanged=0

# indicates whether a new domain record should be created
# if the record does not already exist. It is set to 1 (true) if a new record should be created
# when the domain record is missing, and 0 (false) otherwise.

export arIsCreateRecord=0

################################################################### logger ##

# Output log to stderr

arLog() {

    >&2 echo "$@"

}

################################################################### http client ##

# Use curl or wget open url
# Args: url postdata

arRequest() {

    local url="$1"
    local data="$2"

    local params=""
    local agent="AnripDdns/6.5.0(wang@rehiy.com)"

    if type curl >/dev/null 2>&1; then
        if echo $url | grep -q https; then
            params="$params -k"
        fi
        if [ -n "$data" ]; then
            params="$params -d $data"
        fi
        curl -s -A "$agent" $params $url
        return $?
    fi

    if type wget >/dev/null 2>&1; then
        if echo $url | grep -q https; then
            params="$params --no-check-certificate"
        fi
        if [ -n "$data" ]; then
            params="$params --post-data $data"
        fi
        wget -qO- -U "$agent" $params $url
        return $?
    fi

    return 1

}

################################################################### ipv4 util ##

# Get regular expression for IPv4 LAN addresses

arLanIp4() {

    local lanIps="^$"

    lanIps="$lanIps|(^10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$)"            # RFC1918
    lanIps="$lanIps|(^100\.(6[4-9]|[7-9][0-9])\.[0-9]{1,3}\.[0-9]{1,3}$)"  # RFC6598 100.64.x.x - 100.99.x.x
    lanIps="$lanIps|(^100\.1([0-1][0-9]|2[0-7])\.[0-9]{1,3}\.[0-9]{1,3}$)" # RFC6598 100.100.x.x - 100.127.x.x
    lanIps="$lanIps|(^127\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$)"           # RFC1122
    lanIps="$lanIps|(^169\.254\.[0-9]{1,3}\.[0-9]{1,3}$)"                  # RFC3927
    lanIps="$lanIps|(^172\.(1[6-9]|2[0-9]|3[0-1])\.[0-9]{1,3}\.[0-9]{1,3}$)" # RFC1918
    lanIps="$lanIps|(^192\.0\.2\.[0-9]{1,3}$)"                             # RFC5737
    lanIps="$lanIps|(^192\.168\.[0-9]{1,3}\.[0-9]{1,3}$)"                  # RFC1918
    lanIps="$lanIps|(^198\.1[8-9]\.[0-9]{1,3}\.[0-9]{1,3}$)"               # RFC2544
    lanIps="$lanIps|(^198\.51\.100\.[0-9]{1,3}$)"                          # RFC5737
    lanIps="$lanIps|(^203\.0\.113\.[0-9]{1,3}$)"                           # RFC5737
    lanIps="$lanIps|(^2[4-5][0-9]\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$)"   # RFC1112

    echo $lanIps

}

# Get IPv4 by ip route or network

arWanIp4() {

    local hostIp
    local lanIps=$(arLanIp4)

    case $(uname) in
        'Linux')
            hostIp=$(ip -o -4 route get 100.64.0.1 | grep -oE 'src [0-9\.]+' | awk '{print $2}' | grep -Ev "$lanIps")
        ;;
        Darwin|FreeBSD)
            hostIp=$(ifconfig | grep "inet " | grep -v 127.0.0.1 | awk '{print $2}' | grep -Ev "$lanIps")
        ;;
    esac

    if [ -z "$hostIp" ]; then
        hostIp=$(arRequest $arIp4QueryUrl)
    fi

    if [ -z "$hostIp" ]; then
        return 2
    fi

    if [ -z "$(echo $hostIp | grep -E '^[0-9\.]+$')" ]; then
        arLog "> arWanIp4 - Invalid ip address"
        return 1
    fi

    echo $hostIp

}

# Get IPv4 from a specific interface
# Args: interface

arDevIp4() {

    local hostIp
    local lanIps=$(arLanIp4)

    case $(uname) in
        'Linux')
            hostIp=$(ip -o -4 addr show dev $1 primary | grep -oE 'inet [0-9.]+' | awk '{print $2}' | grep -Ev "$lanIps" | head -n 1)
        ;;
    esac

    if [ -z "$hostIp" ]; then
        arLog "> arDevIp4 - Can't get ip address"
        return 1
    fi

    if [ -z "$(echo $hostIp | grep -E '^[0-9\.]+$')" ]; then
        arLog "> arDevIp4 - Invalid ip address"
        return 1
    fi

    echo $hostIp

}

################################################################### ipv6 util ##

# Get regular expression for IPv6 LAN addresses

arLanIp6() {

    local lanIps="(^$)"

    lanIps="$lanIps|(^::1$)"                            # RFC4291
    lanIps="$lanIps|(^64:[fF][fF]9[bB]:)"               # RFC6052, RFC8215
    lanIps="$lanIps|(^100::)"                           # RFC6666
    lanIps="$lanIps|(^2001:2:0?:)"                      # RFC5180
    lanIps="$lanIps|(^2001:[dD][bB]8:)"                 # RFC3849
    lanIps="$lanIps|(^[fF][cdCD][0-9a-fA-F]{2}:)"       # RFC4193 Unique local addresses
    lanIps="$lanIps|(^[fF][eE][8-9a-bA-B][0-9a-fA-F]:)" # RFC4291 Link-local addresses

    echo $lanIps

}

# Get IPv6 by ip route or network

arWanIp6() {

    local hostIp
    local lanIps=$(arLanIp6)

    case $(uname) in
        'Linux')
            hostIp=$(ip -o -6 route get 100::1 | grep -oE 'src [0-9a-fA-F:]+' | awk '{print $2}' | grep -Ev "$lanIps")
        ;;
    esac

    if [ -z "$hostIp" ]; then
        hostIp=$(arRequest $arIp6QueryUrl)
    fi

    if [ -z "$hostIp" ]; then
        arLog "> arWanIp6 - Can't get ip address"
        return 1
    fi

    if [ -z "$(echo $hostIp | grep -E '^[0-9a-fA-F:]+$')" ]; then
        arLog "> arWanIp6 - Invalid ip address"
        return 1
    fi

    echo $hostIp

}

# Get IPv6 from a specific interface
# Args: interface

arDevIp6() {

    local hostIp
    local lanIps=$(arLanIp6)

    case $(uname) in
        'Linux')
            # Try obtain home address (a speical permanent address for mobile devices)
            hostIp=$(ip -o -6 addr show dev $1 scope global home | grep -oE 'inet6 [0-9a-fA-F:]+' | awk '{print $2}' | grep -Ev "$lanIps")
            if [ -z "$hostIp" ]; then # Try obtain permanent address
                hostIp=$(ip -o -6 addr show dev $1 scope global permanent | grep -oE 'inet6 [0-9a-fA-F:]+' | awk '{print $2}' | grep -Ev "$lanIps")
            fi
            if [ -z "$hostIp" ]; then # Try obtain non-deprecated primary (non-temporary) non-mngtmpaddr (mngtmpaddr is template for temporary address creation) address then
                hostIp=$(ip -o -6 addr show dev $1 scope global -deprecated primary | grep -v mngtmpaddr | grep -oE 'inet6 [0-9a-fA-F:]+' | awk '{print $2}' | grep -Ev "$lanIps")
            fi
            if [ -z "$hostIp" ]; then # Try obtain non-deprecated primary address then
                hostIp=$(ip -o -6 addr show dev $1 scope global -deprecated primary | grep -oE 'inet6 [0-9a-fA-F:]+' | awk '{print $2}' | grep -Ev "$lanIps")
            fi
            if [ -z "$hostIp" ]; then # Try obtain non-deprecated address any at last
                hostIp=$(ip -o -6 addr show dev $1 scope global -deprecated | grep -oE 'inet6 [0-9a-fA-F:]+' | awk '{print $2}' | grep -Ev "$lanIps")
            fi
            hostIp=$(echo "$hostIp" | head -n 1) # Fetch at most one address
        ;;
    esac

    if [ -z "$hostIp" ]; then
        arLog "> arDevIp6 - Can't get ip address"
        return 1
    fi

    if [ -z "$(echo $hostIp | grep -E '^[0-9a-fA-F:]+$')" ]; then
        arLog "> arDevIp6 - Invalid ip address"
        return 1
    fi

    echo $hostIp

}

################################################################### dnspod api ##

# Dnspod Bridge
# Args: interface data

arDdnsApi() {

    local dnsapi="https://dnsapi.cn/${1:?'Info.Version'}"
    local params="login_token=$arToken&format=json&lang=en&$2"

    arRequest "$dnsapi" "$params"

}

# 下面的 JSON 解析只用 tr/sed/head/wc 的"固定字符串 + [0-9] 类 + * 量词",
# 不用 awk, 不用 ? 量词, 也不用 grep -o。
# 原因(实测, 路由器 busybox 环境): 之前的取 id 正则写成 `"id": ?"?[0-9]+`, 带 ? 量词,
# 在设备上一律匹配不到; 而取 name/type/message/code 的那些不带 ? 的表达式却一直是好的 ——
# 所以现场表现为"日志里能看到 类型 A, 却怎么也拿不到记录 id", 进而被误判成记录不存在。
# 现在改成: JSON 压成裸形式 -> 每条记录一行 -> 每个字段一行 -> 固定字符串精确比对。
# 这几个函数可以用真实 API 响应直接跑回归(dnsapi.cn 的 Record.List 原始响应即可)。

# 把 JSON 响应压成"裸形式":
#   {  "id": "123",  "name":"ct" }   ->   {id:123,name:ct}
# 好处: id 带不带引号(字符串/数字)、json 有没有被美化换行/冒号两侧有没有空格,
#       都只对应一种匹配规则。数值之外的空白一律压掉(只影响排障显示, 不影响取值)。
# Args: jsonResponse
arJsonBare() {
    echo "$1" | tr -d '\n\r\t' \
        | sed -e 's/[ ]*:[ ]*/:/g' \
              -e 's/[ ]*,[ ]*/,/g' \
              -e 's/[ ]*{[ ]*/{/g' \
              -e 's/[ ]*}[ ]*/}/g' \
              -e 's/[ ]*\[[ ]*/[/g' \
              -e 's/[ ]*][ ]*/]/g' \
        | tr -d '"'
}

# 只取 records 数组部分(丢掉 status/domain/info 段, 免得把 domain 的 id 当成记录 id),
# 并把每条记录切成单独一行(记录之间一定是 "},{" )。
# 找不到 records 数组时输出空 —— 上层按"没有记录"处理, 不会退化成匹配 domain 的 id。
# Args: jsonResponse
arJsonRecords() {
    arJsonBare "$1" | sed -n 's/.*records:\[/[/p' | sed 's/},{/}\n{/g' | grep -v '^\[\]'
}

# 取一条记录里某个字段的值(字段名: id/name/type/line/value)。
# 做法: 行内的 { } , 都当分隔符换成换行, 于是每个字段独占一行, 再用锚定的固定串取值
#       —— 不涉及任何正则元字符, 各平台行为完全一致。
# Args: recordLine fieldName
arRecordField() {
    echo "$1" | tr '{,}' '\n\n\n' | sed -n "s/^$2:\(.*\)$/\1/p" | head -n 1
}

# 从一条记录里取 id(字段名是锚定的, 不会误取 line_id/domain_id)。
# Args: recordLine
arRecordId() {
    arRecordField "$1" id
}

# records 数组里的记录条数(拿不到输出 0)。
# Args: jsonResponse
arJsonRecordCount() {
    local recs
    recs=$(arJsonRecords "$1")
    [ -z "$recs" ] && { echo 0 ; return ; }
    printf '%s\n' "$recs" | wc -l | tr -d ' '
}

# records 数组里第一条记录的 id(只在数组确定只有一条记录时使用, 不会张冠李戴)。
# Args: jsonResponse
arJsonFirstRecordId() {
    local line
    line=$(arJsonRecords "$1" | head -n 1)
    [ -n "$line" ] && arRecordId "$line"
}

# records 数组里第一条记录的类型(配合"只有一条记录"的判断使用)。
# Args: jsonResponse
arJsonFirstRecordType() {
    local line
    line=$(arJsonRecords "$1" | head -n 1)
    [ -n "$line" ] && arRecordField "$line" type
}

# 从响应里取第一个记录 id(Record.Create / Record.Info 的响应里, 第一个 id 就是记录 id)。
# Args: jsonResponse
arJsonId() {
    arJsonBare "$1" | tr '{,}' '\n\n\n' | sed -n 's/^id:\([0-9][0-9]*\).*$/\1/p' | head -n 1
}

# 同上, 但只取 records 数组内的第一个 id, 避免取到响应里 domain 的 id。
# Args: jsonResponse
arJsonRecordId() {
    arJsonFirstRecordId "$1"
}

# 取响应里的 info 段(很短), 用来判断这次查询到底看到了几条记录。
# 排障必备: 排障日志之前只截原始响应前 200 字符, 全被 domain 段占满, 等于没打。
# Args: jsonResponse
arJsonInfo() {
    local info
    info=$(arJsonBare "$1" | sed -n 's/.*\(info:{[^}]*}\).*/\1/p' | head -n 1)
    [ -z "$info" ] && info='(无 info 段)'
    echo "$info"
}

# 排障用一行摘要: 记录条数 + 与目标同名的记录(名字/类型/线路/值) + 前 8 个主机记录名。
# 有了它就能一眼看出"目标记录到底在不在 returned 列表里、类型是什么"。
# Args: jsonResponse recordName
arJsonRecordBrief() {
    local recs cnt same names want

    recs=$(arJsonRecords "$1")
    if [ -z "$recs" ] ; then
        echo "共 0 条(records 数组为空或未找到)"
        return
    fi

    want=$(echo "$2" | tr 'A-Z' 'a-z')
    cnt=$(printf '%s\n' "$recs" | wc -l | tr -d ' ')
    same=$(printf '%s\n' "$recs" | while read -r line ; do
        n=$(arRecordField "$line" name | tr 'A-Z' 'a-z')
        [ "$n" = "$want" ] || continue
        echo "name:$(arRecordField "$line" name) type:$(arRecordField "$line" type) line:$(arRecordField "$line" line) value:$(arRecordField "$line" value)"
    done | tr '\n' ' ')
    [ -z "$same" ] && same="无"
    names=$(printf '%s\n' "$recs" | while read -r line ; do arRecordField "$line" name ; done \
        | head -n 8 | tr '\n' ' ')

    echo "共 $cnt 条; 同名: $same; 前 8 个主机记录名: $names"
}

# 按 主机记录名(+类型) 在 records 里挑 id, 不依赖 DNSPod 的服务端过滤。
# 为什么需要: 实测 Record.List 带上 sub_domain/record_type 过滤会返回空 records,
# 而 Record.Create 却认为同名记录已存在 —— 直接用全量记录在本地匹配, 绕开该过滤。
# 记录名比较忽略大小写(DNS 主机记录本身不区分大小写)。
# Args: jsonResponse recordName [recordType]
arJsonPickRecordId() {
    local recs cand line n t want

    recs=$(arJsonRecords "$1")
    [ -z "$recs" ] && return 0
    want=$(echo "$2" | tr 'A-Z' 'a-z')

    # 固定串粗筛(名字里的 . * 等不会被当成正则), 再逐行取字段精确比对
    cand=$(echo "$recs" | grep -F -i -e "name:$2," -e "name:$2}")
    [ -z "$cand" ] && return 0

    echo "$cand" | while read -r line ; do
        n=$(arRecordField "$line" name | tr 'A-Z' 'a-z')
        [ "$n" = "$want" ] || continue
        if [ -n "$3" ] ; then
            t=$(arRecordField "$line" type | tr 'a-z' 'A-Z')
            [ "$t" = "$(echo "$3" | tr 'a-z' 'A-Z')" ] || continue
        fi
        arRecordId "$line"
        break
    done
}

# 取同名记录的现有类型(A/CNAME/...), 找不到输出空。
# 用于区分"真的类型冲突"(DNSPod 里 A 与 CNAME/URL 记录不可共存)和"只是没解析出来":
# 只有类型确实不同, 才该提示用户去 DNSPod 后台处理。
# Args: jsonResponse recordName
arJsonPickRecordType() {
    local recs cand line n want

    recs=$(arJsonRecords "$1")
    [ -z "$recs" ] && return 0
    want=$(echo "$2" | tr 'A-Z' 'a-z')
    cand=$(echo "$recs" | grep -F -i -e "name:$2," -e "name:$2}")
    [ -z "$cand" ] && return 0

    echo "$cand" | while read -r line ; do
        n=$(arRecordField "$line" name | tr 'A-Z' 'a-z')
        [ "$n" = "$want" ] || continue
        arRecordField "$line" type
        break
    done
}

# 分三轮查记录 id, 每轮绕开一种失败模式:
#   轮 1: sub_domain + record_type + record_line_id=0  (与 Create 条件一致, 最快)
#   轮 2: 只带 sub_domain, 本地按记录名+类型匹配       (绕开 line/type 过滤)
#   轮 3: 拉全量记录, 本地按记录名+类型匹配            (绕开 sub_domain 过滤本身)
# 命中返回 0 并把 id 放进全局 arFoundId。
# 未命中返回 1, arFoundId 为空, 同时:
#   全局 arListRs        = 最后一次的原始响应(供上层打日志)
#   全局 arListOtherType = 同名记录的现有类型(用于判断是不是真的类型冲突)
# 注意: 必须直接调用(不能放 $(...) 里), 否则这里的全局变量回传不到调用方。
# Args: domain subdomain recordType
arDdnsFindId() {
    local id
    local sr=""

    [ "$2" != "@" ] && [ -n "$2" ] && sr="&sub_domain=$2"
    arFoundId=""
    arListOtherType=""

    # 轮 1: 服务端已按 sub_domain+record_type 过滤, 正常情况下一次命中。
    arListRs=$(arDdnsApi "Record.List" "domain=$1${sr}&record_type=$3&record_line_id=0")
    id=$(arJsonPickRecordId "$arListRs" "$2" "$3")
    if [ -z "$id" ] && [ "$(arJsonRecordCount "$arListRs")" = "1" ] \
        && [ "$(arJsonFirstRecordType "$arListRs")" = "$3" ] ; then
        # 数组里恰好只有这一条记录, 且类型一致 —— 那它就是要找的那条, 名字写法/大小写
        # 有出入时也能救回来。类型必须先核对: 否则会把同名不同型(CNAME/URL 等)的记录
        # 当成目标, 那属于真实的类型冲突, 不能拿来更新。
        id=$(arJsonFirstRecordId "$arListRs")
    fi
    if [ -n "$id" ] ; then arFoundId="$id" ; return 0 ; fi

    # 轮 2: 只按子域名查(DNSPod 的 type/line 过滤在部分套餐上会漏返回记录)。
    arListRs=$(arDdnsApi "Record.List" "domain=$1${sr}")
    id=$(arJsonPickRecordId "$arListRs" "$2" "$3")
    if [ -n "$id" ] ; then arFoundId="$id" ; return 0 ; fi

    # 轮 3: 拉全量记录, 完全绕开服务端过滤。
    arListRs=$(arDdnsApi "Record.List" "domain=$1")
    id=$(arJsonPickRecordId "$arListRs" "$2" "$3")
    arListOtherType=$(arJsonPickRecordType "$arListRs" "$2")
    if [ -n "$id" ] ; then arFoundId="$id" ; return 0 ; fi

    return 1
}

# Fetch Record Id
# Args: domain subdomain recordType

arDdnsLookup() {

    local errMsg
    local recordId
    local recordCd

    # 三轮查询(见 arDdnsFindId 注释), 结果响应留在 arListRs
    arDdnsFindId "$1" "$2" "$3"
    recordId="$arFoundId"

    if [ -z "$recordId" ] ;then
        # DNSPod api code: "1"=调用成功(不代表查到了记录), 负数=鉴权/参数等真错误
        recordCd=$(echo $arListRs | sed 's/.*{"code":"\([0-9-]*\)".*/\1/')
        errMsg=$(echo $arListRs | sed 's/.*"message":"\([^\"]*\)".*/\1/')
        arLog "> arDdnsLookup - $errMsg"
        # 打 info 段(记录总数)+ 记录条数/同名记录清单, 而不是把整段响应截 200 字符
        # (前 200 字符全被 domain 段占满, 排障时等于没打)
        arLog "> arDdnsLookup - $(arJsonInfo "$arListRs")"
        arLog "> arDdnsLookup - $(arJsonRecordBrief "$arListRs" "$2")"
        # 同名记录存在且类型与要写入的不同(A 与 CNAME/URL 在 DNSPod 里不能共存):
        # 再 Create 也只会回"已存在", 这里直接报出真实原因, 免得页面把它显示成
        # 误导性的"解析记录不存在"。注意必须比较类型, 否则同名同类型会被误报成冲突。
        if [ -n "$arListOtherType" ] && [ "$arListOtherType" != "$3" ] ; then
            arLog "> arDdnsLookup - error: 同名记录已存在(类型 $arListOtherType), 与 $3 冲突"
            return 1
        fi
        if [ $arIsCreateRecord -eq 1 ]; then
            # DNSPod 记录不存在有三种表现, 只认 message 会让"自动创建"永远走不到:
            #   1) message = "No records on the list"
            #   2) 返回空 records 数组(可能没有 message 字段)
            #   3) message = "Operation successful"(code=1, api 调用成功但查不到记录 id)
            #      这是最常见的一种, 语义是"记录不存在"而非"出错"
            if [ "$errMsg" = "No records on the list" ] || [ "$recordCd" = "1" ]; then
                arLog "> arDdnsLookup - No records on the list"
                return 2
            fi
            if echo "$arListRs" | grep -q '"records":\[\]'; then
                arLog "> arDdnsLookup - No records on the list"
                return 2
            fi
        fi
        return 1
    fi

    echo $recordId
}

# Update Record Value
# Args: domain subdomain recordId recordType [hostIp]

arDdnsUpdate() {

    local errMsg

    local recordRs
    local recordCd
    local recordIp

    local lastRecordIp
    local lastRecordIpFile="$arLastRecordFile.$3"

    # fetch last ip
    if [ -f $lastRecordIpFile ]; then
        lastRecordIp=$(cat $lastRecordIpFile)
    fi

    # fetch from api
    if [ -z "$lastRecordIp" ]; then
        recordRs=$(arDdnsApi "Record.Info" "domain=$1&record_id=$3")
        recordCd=$(echo $recordRs | sed 's/.*{"code":"\([0-9]*\)".*/\1/')
        lastRecordIp=$(echo $recordRs | sed 's/.*,"value":"\([0-9a-fA-F\.\:]*\)".*/\1/')
    fi

    # update ip
    if [ -z "$5" ]; then
        recordRs=$(arDdnsApi "Record.Ddns" "domain=$1&sub_domain=$2&record_id=$3&record_type=$4&record_line_id=0")
    else
        if [ "$5" = "$lastRecordIp" ]; then
            arLog "> arDdnsUpdate - unchanged: $lastRecordIp" # unchanged event
            return $arErrCodeUnchanged
        fi
        recordRs=$(arDdnsApi "Record.Ddns" "domain=$1&sub_domain=$2&record_id=$3&record_type=$4&value=$5&record_line_id=0")
    fi

    # parse result
    recordCd=$(echo $recordRs | sed 's/.*{"code":"\([0-9]*\)".*/\1/')
    recordIp=$(echo $recordRs | sed 's/.*,"value":"\([0-9a-fA-F\.\:]*\)".*/\1/')

    # check result
    if [ "$recordCd" != "1" ]; then
        errMsg=$(echo $recordRs | sed 's/.*,"message":"\([^"]*\)".*/\1/')
        arLog "> arDdnsUpdate - error: $errMsg"
        return 1
    elif [ "$recordIp" = "$lastRecordIp" ]; then
        arLog "> arDdnsUpdate - unchanged: $recordIp" # unchanged event
        return $arErrCodeUnchanged
    else
        arLog "> arDdnsUpdate - updated: $recordIp" # updated event
        if [ -n "$lastRecordIpFile" ]; then
            echo $recordIp > $lastRecordIpFile
        fi
        return 0
    fi

}

